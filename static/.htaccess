# 星詠魔力工具站（SiteGround / Apache）
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType font/woff .woff
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On
  # 一律走 HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # 去掉 www，統一網址（SEO）
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # /index.html → /（避免重複內容）
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
  RewriteRule ^(.*?)index\.html$ /$1 [L,R=301]
  # 寵物圖片延遲快取：檔案不存在時交給 PHP 抓一次
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^img/pets/(\d{1,9})\.gif$ api/petimg.php?id=$1 [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # 檔名帶雜湊的資產：快取一年
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(icons|img)/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
  <FilesMatch "\.(html|webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/"
  </Files>
  <Files "pets.json">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </Files>
</IfModule>

# 不讓外界讀到備份與設定
<FilesMatch "\.(prev|tmp|lock|log|md|mjs|py)$">
  Require all denied
</FilesMatch>
